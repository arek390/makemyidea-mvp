{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.makemyidea.work"
        }
      ],
      "destination": "/_sites/makemyidea/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "makemyidea.work"
        }
      ],
      "destination": "/_sites/makemyidea/index.html"
    },
    {
      "source": "/",
